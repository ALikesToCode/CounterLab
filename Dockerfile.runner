FROM python:3.12-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b AS python-builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SOURCE_DATE_EPOCH=315532800

WORKDIR /build

COPY LICENSE requirements.build.lock.txt pyproject.toml ./
COPY services/kernel/src ./services/kernel/src

RUN python -m venv /opt/counterlab-build-venv \
    && /opt/counterlab-build-venv/bin/pip install --require-hashes --only-binary=:all: -r requirements.build.lock.txt \
    && /opt/counterlab-build-venv/bin/pip wheel --no-build-isolation --no-deps --wheel-dir /wheelhouse . \
    && sha256sum /wheelhouse/*.whl > /wheelhouse/SHA256SUMS

FROM node:22-bookworm-slim@sha256:d415caac2f1f77b98caaf9415c5f807e14bc8d7bdea62561ea2fef4fbd08a73c AS node-builder

ENV COREPACK_HOME=/opt/corepack

RUN corepack enable pnpm \
    && corepack prepare pnpm@11.12.0+sha512.820a6fbd0d9f04c226638002aead1e45340a9139dd5dc077c1d83ef44aa2481c8eb6637b4c9aa696a3c7e35ba818e49cf27213e5f2b91138d09b7a3e26e898ba --activate

WORKDIR /build

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json vitest.config.ts ./
COPY packages/contracts ./packages/contracts
COPY packages/codex-client ./packages/codex-client
COPY packages/session-core ./packages/session-core
COPY services/hosted-runner ./services/hosted-runner

RUN pnpm install --frozen-lockfile --filter @counterlab/hosted-runner... \
    && node_modules/.pnpm/esbuild@0.28.1/node_modules/esbuild/bin/esbuild \
        services/hosted-runner/src/server.ts \
        --bundle \
        --platform=node \
        --format=esm \
        --target=node22 \
        --outfile=/out/runner.mjs \
    && node --check /out/runner.mjs \
    && mkdir -p /out/codex \
    && cp -a /build/node_modules/.pnpm/@openai+codex@0.144.4-linux-x64/node_modules/@openai/codex/vendor/x86_64-unknown-linux-musl/. /out/codex/ \
    && chmod -R a+rX /out

FROM python:3.12-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b

ARG COUNTERLAB_SOURCE_COMMIT=unbound

LABEL org.opencontainers.image.licenses="MIT" \
    org.opencontainers.image.revision="${COUNTERLAB_SOURCE_COMMIT}" \
    org.opencontainers.image.source="https://github.com/ALikesToCode/CounterLab"

ENV DEBIAN_FRONTEND=noninteractive \
    BLIS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VECLIB_MAXIMUM_THREADS=1 \
    PATH=/opt/counterlab-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

COPY --from=node-builder /usr/local/bin/node /usr/local/bin/node

RUN test -x /usr/sbin/groupadd \
    && test -x /usr/sbin/useradd \
    && test -x /usr/bin/setpriv \
    && groupadd --gid 10001 counterlab-codex \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin counterlab-codex \
    && python -m venv /opt/counterlab-venv

WORKDIR /app

COPY pyproject.toml requirements.runner.lock.txt ./
COPY fixtures/public/customer_churn.csv ./fixtures/public/customer_churn.csv
COPY fixtures/public/fraud_rare_event.csv ./fixtures/public/fraud_rare_event.csv
COPY --from=python-builder /wheelhouse/ /opt/counterlab-wheelhouse/
COPY --from=node-builder /out/runner.mjs /app/runner.mjs
COPY --from=node-builder /out/codex/ /opt/codex/

RUN chmod -R a+rX /opt/codex \
    && ln -s /opt/codex/bin/codex /usr/local/bin/codex \
    && /opt/counterlab-venv/bin/pip install --no-cache-dir --require-hashes --only-binary=:all: -r requirements.runner.lock.txt \
    && /opt/counterlab-venv/bin/pip install --no-cache-dir --no-deps --no-index --find-links=/opt/counterlab-wheelhouse counterlab-kernel==0.1.0 \
    && /opt/counterlab-venv/bin/pip check \
    && mkdir -p /work/jobs /run/counterlab-codex \
    && chown -R counterlab-codex:counterlab-codex /app /work/jobs /run/counterlab-codex \
    && chmod 700 /app /work/jobs /run/counterlab-codex \
    && chmod 500 /app/runner.mjs

USER 10001:10001

EXPOSE 8080

CMD ["node", "/app/runner.mjs"]
