{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://counterlab.local/schemas/held-out-result-v1.json",
  "title": "CounterLab held-out benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "benchmarkId",
    "executedAt",
    "parser",
    "executionMode",
    "labelsSha256",
    "summary",
    "cases",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "benchmarkId": { "const": "counterlab-held-out-v1" },
    "executedAt": { "type": "string", "format": "date-time" },
    "parser": { "const": "@counterlab/notebook-parser" },
    "executionMode": { "const": "safe_parse_no_cell_execution" },
    "labelsSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "byFamily"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "byFamily": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entity_leakage", "class_imbalance", "unsupported"],
          "properties": {
            "entity_leakage": { "$ref": "#/$defs/familyCount" },
            "class_imbalance": { "$ref": "#/$defs/familyCount" },
            "unsupported": { "$ref": "#/$defs/familyCount" }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/caseResult" }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "familyCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "total"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "fileName",
        "family",
        "variation",
        "humanReviewStatus",
        "executedParser",
        "expected",
        "observed",
        "checks",
        "passed"
      ],
      "properties": {
        "caseId": { "type": "string" },
        "fileName": { "type": "string" },
        "family": {
          "enum": ["entity_leakage", "class_imbalance", "unsupported"]
        },
        "variation": { "type": "string" },
        "humanReviewStatus": {
          "enum": ["PENDING", "REVIEWED", "ADJUDICATED"]
        },
        "executedParser": { "const": true },
        "expected": { "type": "object" },
        "observed": { "type": "object" },
        "checks": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        },
        "passed": { "type": "boolean" }
      }
    }
  }
}
