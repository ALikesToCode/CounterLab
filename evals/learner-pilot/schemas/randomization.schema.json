{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://counterlab.local/schemas/pilot-randomization-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "method",
    "seed",
    "slots",
    "assignments",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "method": { "const": "permuted_balanced_concept_order" },
    "seed": { "type": "integer" },
    "slots": { "type": "integer", "minimum": 2, "maximum": 200 },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slotId", "sequence"],
        "properties": {
          "slotId": { "type": "string", "pattern": "^slot_\\d{3}$" },
          "sequence": { "enum": ["leakage_first", "imbalance_first"] }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
