{
  "$id": "https://counterlab.dev/schemas/boundary-map-receipt-v1.schema.json",
  "title": "CounterLab Boundary Map receipt v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "canonicalProfile": {
      "type": "string",
      "const": "counterlab-canonical-json-v1"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "resultHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verificationReportHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "experimentIrHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authoritativeResultHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidenceVerdictHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "integrity": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "integrity-hashed"
            },
            "algorithm": {
              "type": "string",
              "const": "sha256"
            },
            "contentHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "mode",
            "algorithm",
            "contentHash"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "hmac-signed"
            },
            "algorithm": {
              "type": "string",
              "const": "hmac-sha256"
            },
            "contentHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "signature": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "keyId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._:-]{0,95}$"
            }
          },
          "required": [
            "mode",
            "algorithm",
            "contentHash",
            "signature",
            "keyId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "receiptHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "canonicalProfile",
    "sessionId",
    "resultHash",
    "verificationReportHash",
    "experimentIrHash",
    "authoritativeResultHash",
    "evidenceVerdictHash",
    "issuedAt",
    "integrity",
    "receiptHash"
  ],
  "additionalProperties": false
}
