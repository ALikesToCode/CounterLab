                  "replace_row_split_with_group_holdout",
                  "exclude_entity_feature",
                  "stratify_classification_holdout",
                  "add_majority_baseline",
                  "replace_accuracy_only_evaluation"
                ]
              },
              "cellIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "cellIndex",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "planId",
        "sessionId",
        "conceptPackVersion",
        "artifactManifestHash",
        "sourceArtifactHash",
        "transferResultHash",
        "verifiedResultHash",
        "evidenceRefs",
        "targetCells",
        "preserveUnrelatedCells",
        "nonClaims",
        "concept",
        "targetField",
        "operations"
      ],
      "additionalProperties": false
    }
  ]
