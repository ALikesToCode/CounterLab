                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "outputIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "kind": {
                "type": "string",
                "enum": [
                  "code",
                  "metric",
                  "schema",
                  "output",
                  "learner_claim"
                ]
              },
              "hash": {
                "type": "string",
