{
  "$id": "https://counterlab.dev/schemas/experiment-plan-v2.schema.json",
  "title": "CounterLab hosted Experiment Plan v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2"
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "concept": {
      "type": "string",
      "enum": [
        "entity_leakage",
        "class_imbalance"
      ]
    },
    "conceptPackVersion": {
      "type": "string",
      "minLength": 1
    },
    "artifactManifestHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "beliefTestId": {
      "type": "string",
      "minLength": 1
    },
    "evidenceRefs": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cellIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "outputIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "enum": [
              "code",
              "metric",
              "schema",
              "output",
              "learner_claim"
            ]
          },
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "excerpt": {
            "type": "string",
            "maxLength": 2000
          },
          "relevance": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "hash",
          "excerpt",
          "relevance"
        ],
        "additionalProperties": false
      }
    },
    "baseline": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "concept": {
              "type": "string",
              "const": "entity_leakage"
            },
            "runId": {
              "type": "string",
              "minLength": 1
            },
            "operation": {
              "type": "string",
              "enum": [
                "leakage.random_row_split",
                "leakage.group_holdout",
                "leakage.identity_ablation"
              ]
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "testFraction": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 0.5
            },
            "entityField": {
              "type": "string",
              "minLength": 1
            },
            "dropIdentity": {
              "type": "boolean"
            },
            "model": {
              "type": "string",
              "const": "logistic_regression"
            }
          },
          "required": [
            "concept",
            "runId",
            "operation",
            "seed",
            "testFraction",
            "entityField",
            "dropIdentity",
            "model"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "concept": {
              "type": "string",
              "const": "class_imbalance"
            },
            "runId": {
              "type": "string",
              "minLength": 1
            },
            "operation": {
              "type": "string",
              "enum": [
                "imbalance.majority_baseline",
                "imbalance.stratified_holdout",
                "imbalance.threshold_sweep",
                "imbalance.prevalence_sweep"
              ]
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "threshold": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 0.95
            },
            "prevalenceScenario": {
              "type": "string",
              "enum": [
                "observed",
                "rarer",
                "more_common"
              ]
            },
            "model": {
              "type": "string",
              "enum": [
                "logistic_regression",
                "majority_baseline"
              ]
            }
          },
          "required": [
            "concept",
            "runId",
            "operation",
            "seed",
            "threshold",
            "prevalenceScenario",
            "model"
          ],
          "additionalProperties": false
        }
      ]
    },
    "interventions": {
      "minItems": 1,
      "maxItems": 7,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "concept": {
                "type": "string",
                "const": "entity_leakage"
              },
              "runId": {
                "type": "string",
                "minLength": 1
              },
              "operation": {
                "type": "string",
                "enum": [
                  "leakage.random_row_split",
                  "leakage.group_holdout",
                  "leakage.identity_ablation"
                ]
              },
              "seed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "testFraction": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 0.5
              },
              "entityField": {
                "type": "string",
                "minLength": 1
              },
              "dropIdentity": {
                "type": "boolean"
              },
              "model": {
                "type": "string",
                "const": "logistic_regression"
              }
            },
            "required": [
              "concept",
              "runId",
              "operation",
              "seed",
              "testFraction",
              "entityField",
              "dropIdentity",
              "model"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "concept": {
                "type": "string",
                "const": "class_imbalance"
              },
              "runId": {
                "type": "string",
                "minLength": 1
              },
              "operation": {
                "type": "string",
                "enum": [
                  "imbalance.majority_baseline",
                  "imbalance.stratified_holdout",
                  "imbalance.threshold_sweep",
                  "imbalance.prevalence_sweep"
                ]
              },
              "seed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "threshold": {
                "type": "number",
                "minimum": 0.05,
                "maximum": 0.95
              },
              "prevalenceScenario": {
                "type": "string",
                "enum": [
                  "observed",
                  "rarer",
                  "more_common"
                ]
              },
              "model": {
                "type": "string",
                "enum": [
                  "logistic_regression",
                  "majority_baseline"
                ]
              }
            },
            "required": [
              "concept",
              "runId",
              "operation",
              "seed",
              "threshold",
              "prevalenceScenario",
              "model"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "controlledVariables": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "changedVariables": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metrics": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "accuracy",
          "roc_auc",
          "entity_overlap_rate",
          "precision",
          "recall",
          "f1",
          "pr_auc",
          "confusion_matrix",
          "prevalence"
        ]
      }
    },
    "visualizations": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "metric_comparison",
          "entity_overlap",
          "confusion_matrix",
          "threshold_curve",
          "prevalence_sensitivity"
        ]
      }
    },
    "discriminatesBecause": {
      "type": "string",
      "minLength": 1
    },
    "expectedPatterns": {
      "minItems": 2,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hypothesisId": {
            "type": "string",
            "enum": [
              "current",
              "competing"
            ]
          },
          "qualitativeOutcome": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "hypothesisId",
          "qualitativeOutcome"
        ],
        "additionalProperties": false
      }
    },
    "nonClaims": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resourceLimits": {
      "type": "object",
      "properties": {
        "wallSeconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "memoryMb": {
          "type": "integer",
          "minimum": 128,
          "maximum": 2048
        },
        "maxRuns": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 8
        }
      },
      "required": [
        "wallSeconds",
        "memoryMb",
        "maxRuns"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "planId",
    "sessionId",
    "concept",
    "conceptPackVersion",
    "artifactManifestHash",
    "beliefTestId",
    "evidenceRefs",
    "baseline",
    "interventions",
    "controlledVariables",
    "changedVariables",
    "metrics",
    "visualizations",
    "discriminatesBecause",
    "expectedPatterns",
    "nonClaims",
    "resourceLimits"
  ],
  "additionalProperties": false
}
