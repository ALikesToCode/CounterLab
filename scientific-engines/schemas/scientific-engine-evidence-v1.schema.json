{
  "$id": "https://counterlab.dev/schemas/scientific-engine-evidence-v1.schema.json",
  "title": "CounterLab scientific engine evidence catalog v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "records": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "license",
              "integrity",
              "oracle_strategy",
              "golden_fixture",
              "metamorphic_property",
              "upgrade_drift_fixture",
              "health_report",
              "tolerance_profile",
              "resource_profile",
              "lockfile",
              "sbom",
              "sbom_manifest",
              "vulnerability_report"
            ]
          },
          "engineId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "VERIFIED",
              "PARTIAL",
              "REJECTED"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "sha256",
          "status",
          "limitations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "records"
  ],
  "additionalProperties": false
}
