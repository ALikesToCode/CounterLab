{
  "$id": "https://counterlab.dev/schemas/release-check-receipt-v2.schema.json",
  "title": "CounterLab release-check receipt v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2"
    },
    "status": {
      "type": "string",
      "const": "PASSED"
    },
    "evidenceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "qualifiedRunnerReceiptSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "qualifiedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "runnerImageTag": {
      "type": "string",
      "pattern": "^counterlab-runner:git-[a-f0-9]{40}$"
    },
    "runnerImageDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "adapterImageTag": {
      "type": "string",
      "pattern": "^counterlab-adapter:git-[a-f0-9]{40}$"
    },
    "adapterImageDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "registryDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "runtimeToolchainSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtimePolicySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "proofDependencyManifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "aggregateLimitEvidenceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtimeAdapterSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checks": {
      "minItems": 11,
      "maxItems": 11,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "test-all",
              "leakage-mutations",
              "imbalance-mutations",
              "held-out",
              "adapter-sandbox-smoke",
              "scientific-engines",
              "web-build",
              "achieved-metrics",
              "reproduce-leakage",
              "replay-patch",
              "secret-scan"
            ]
          },
          "status": {
            "type": "string",
            "const": "PASSED"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "verifierVersion": {
      "type": "string",
      "const": "counterlab-release-check-v2"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "evidenceCommit",
    "sourceCommit",
    "qualifiedRunnerReceiptSha256",
    "qualifiedAt",
    "runnerImageTag",
    "runnerImageDigest",
    "adapterImageTag",
    "adapterImageDigest",
    "registryDigest",
    "runtimeToolchainSha256",
    "runtimePolicySha256",
    "proofDependencyManifestSha256",
    "aggregateLimitEvidenceSha256",
    "runtimeAdapterSha256",
    "checks",
    "checkedAt",
    "verifierVersion"
  ],
  "additionalProperties": false
}
