{
  "$id": "https://counterlab.dev/schemas/qualified-runner-release-v2.schema.json",
  "title": "CounterLab qualified runner release v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2"
    },
    "status": {
      "type": "string",
      "const": "VERIFIED"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sourceArchiveSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceTreeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dockerfileSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "localImageTag": {
      "type": "string",
      "pattern": "^counterlab-runner:git-[a-f0-9]{40}$"
    },
    "localImageDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ociRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "ociSourceTreeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "engineAuthorityHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtimeManifestHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidenceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "registryImage": {
      "type": "string",
      "pattern": "^registry\\.cloudflare\\.com\\/[A-Za-z0-9_-]{3,64}\\/counterlab-runner:git-[a-f0-9]{40}$"
    },
    "registryDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "registryResolvedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "qualifiedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "verifierVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "sourceCommit",
    "sourceArchiveSha256",
    "sourceTreeSha256",
    "dockerfileSha256",
    "localImageTag",
    "localImageDigest",
    "ociRevision",
    "ociSourceTreeSha256",
    "engineAuthorityHash",
    "runtimeManifestHash",
    "evidenceCommit",
    "registryImage",
    "registryDigest",
    "registryResolvedAt",
    "qualifiedAt",
    "verifierVersion"
  ],
  "additionalProperties": false
}
