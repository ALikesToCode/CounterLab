{
  "$id": "https://counterlab.dev/schemas/generation-isolation-evidence-v3.schema.json",
  "title": "CounterLab generation isolation evidence v3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "3"
    },
    "status": {
      "type": "string",
      "const": "VERIFIED"
    },
    "generationFilesystemReadIsolation": {
      "type": "string",
      "const": "OS_ENFORCED"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sourceTreeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "localImageTag": {
      "type": "string",
      "pattern": "^counterlab-runner:git-[a-f0-9]{40}$"
    },
    "localImageDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "imageUser": {
      "type": "string",
      "const": "0:0"
    },
    "policyVersion": {
      "type": "string",
      "const": "counterlab-posix-dac-process-policy-v1"
    },
    "probePayload": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "3"
        },
        "probeVersion": {
          "type": "string",
          "const": "counterlab-generation-isolation-v3"
        },
        "service": {
          "type": "string",
          "const": "counterlab-hosted-runner"
        },
        "probe": {
          "type": "string",
          "const": "non-root-startup"
        },
        "checks": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "const": "entrypoint"
            },
            {
              "type": "string",
              "const": "non-root-user"
            },
            {
              "type": "string",
              "const": "immutable-paths"
            },
            {
              "type": "string",
              "const": "python"
            },
            {
              "type": "string",
              "const": "setpriv"
            },
            {
              "type": "string",
              "const": "privsep-broker"
            },
            {
              "type": "string",
              "const": "posix-dac-process-identity"
            },
            {
              "type": "string",
              "const": "writable-roots"
            }
          ],
          "minItems": 8,
          "maxItems": 8,
          "items": false
        },
        "generationFilesystemReadIsolation": {
          "type": "string",
          "const": "OS_ENFORCED"
        },
        "mechanism": {
          "type": "string",
          "const": "posix-dac-process-identity"
        },
        "brokerIdentity": {
          "type": "string",
          "const": "0:0"
        },
        "runnerIdentity": {
          "type": "string",
          "const": "10001:10001"
        },
        "generatorIdentity": {
          "type": "string",
          "const": "10002:10002"
        },
        "policyVersion": {
          "type": "string",
          "const": "counterlab-posix-dac-process-policy-v1"
        },
        "processIdentity": {
          "type": "object",
          "properties": {
            "brokerUid": {
              "type": "number",
              "const": 0
            },
            "brokerGid": {
              "type": "number",
              "const": 0
            },
            "runnerUid": {
              "type": "number",
              "const": 10001
            },
            "runnerGid": {
              "type": "number",
              "const": 10001
            },
            "generatorUid": {
              "type": "number",
              "const": 10002
            },
            "generatorGid": {
              "type": "number",
              "const": 10002
            },
            "generatorSupplementaryGroupsCleared": {
              "type": "boolean",
              "const": true
            },
            "generatorCapabilitiesEmpty": {
              "type": "boolean",
              "const": true
            },
            "generatorNoNewPrivileges": {
              "type": "boolean",
              "const": true
            },
            "protectedPathsUnreadable": {
              "type": "boolean",
              "const": true
            },
            "protectedPathsUnwritable": {
              "type": "boolean",
              "const": true
            },
            "parentEnvironmentUnreadable": {
              "type": "boolean",
              "const": true
            },
            "brokerEnvironmentUnreadable": {
              "type": "boolean",
              "const": true
            },
            "workspaceVisible": {
              "type": "boolean",
              "const": true
            },
            "workspaceWritable": {
              "type": "boolean",
              "const": true
            },
            "outsideWorkspaceWritesDenied": {
              "type": "boolean",
              "const": true
            },
            "fixedKernelUnavailable": {
              "type": "boolean",
              "const": true
            },
            "credentialReadOnlyDuringInitialization": {
              "type": "boolean",
              "const": true
            },
            "credentialRevocationSupported": {
              "type": "boolean",
              "const": true
            },
            "boundedLaunchesEnforced": {
              "type": "boolean",
              "const": true
            },
            "maximumLaunches": {
              "type": "number",
              "const": 3
            }
          },
          "required": [
            "brokerUid",
            "brokerGid",
            "runnerUid",
            "runnerGid",
            "generatorUid",
            "generatorGid",
            "generatorSupplementaryGroupsCleared",
            "generatorCapabilitiesEmpty",
            "generatorNoNewPrivileges",
            "protectedPathsUnreadable",
            "protectedPathsUnwritable",
            "parentEnvironmentUnreadable",
            "brokerEnvironmentUnreadable",
            "workspaceVisible",
            "workspaceWritable",
            "outsideWorkspaceWritesDenied",
            "fixedKernelUnavailable",
            "credentialReadOnlyDuringInitialization",
            "credentialRevocationSupported",
            "boundedLaunchesEnforced",
            "maximumLaunches"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "probeVersion",
        "service",
        "probe",
        "checks",
        "generationFilesystemReadIsolation",
        "mechanism",
        "brokerIdentity",
        "runnerIdentity",
        "generatorIdentity",
        "policyVersion",
        "processIdentity"
      ],
      "additionalProperties": false
    },
    "probePayloadSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "verifierVersion": {
      "type": "string",
      "const": "counterlab-generation-isolation-evidence-v3"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "generationFilesystemReadIsolation",
    "sourceCommit",
    "sourceTreeSha256",
    "localImageTag",
    "localImageDigest",
    "imageUser",
    "policyVersion",
    "probePayload",
    "probePayloadSha256",
    "verifiedAt",
    "verifierVersion"
  ],
  "additionalProperties": false
}
