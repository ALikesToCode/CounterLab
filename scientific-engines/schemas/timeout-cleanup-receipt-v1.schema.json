{
  "$id": "https://counterlab.dev/schemas/timeout-cleanup-receipt-v1.schema.json",
  "title": "CounterLab contained runtime timeout cleanup receipt v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "status": {
      "type": "string",
      "const": "VERIFIED"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sourceTreeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "buildReceipt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "buildReceiptSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "adapterImageTag": {
      "type": "string",
      "pattern": "^counterlab-adapter:git-[a-f0-9]{40}$"
    },
    "adapterImageDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "adapterManifestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "adapterOciArchiveSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtimeSessionId": {
      "type": "string",
      "pattern": "^rt-[a-z0-9][a-z0-9-]{7,13}$"
    },
    "runtimeToolchainSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtimePolicySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "proofDependencyManifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtimeAttestationSha256Before": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtimeAttestationSha256After": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "driverCliSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "driverModuleSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "probePlanSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "probeAdapterSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "probePublicTestsSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runControlReceipt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "runControlReceiptSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rootlessReceipt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "rootlessReceiptSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "aggregateLimitEvidenceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "invocationId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "finalContainerId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "commandSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidateWallSeconds": {
      "type": "number",
      "const": 30
    },
    "elapsedMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 600000
    },
    "resultReleased": {
      "type": "boolean",
      "const": false
    },
    "cleanup": {
      "type": "object",
      "properties": {
        "taskAbsent": {
          "type": "boolean",
          "const": true
        },
        "containerAbsent": {
          "type": "boolean",
          "const": true
        },
        "snapshotAbsent": {
          "type": "boolean",
          "const": true
        },
        "invocationAliasAbsent": {
          "type": "boolean",
          "const": true
        },
        "imageRootfsAbsent": {
          "type": "boolean",
          "const": true
        },
        "persistedAuthorityVerified": {
          "type": "boolean",
          "const": true
        },
        "readOnlyMountsUnchanged": {
          "type": "boolean",
          "const": true
        },
        "imageRootfsUnchanged": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "taskAbsent",
        "containerAbsent",
        "snapshotAbsent",
        "invocationAliasAbsent",
        "imageRootfsAbsent",
        "persistedAuthorityVerified",
        "readOnlyMountsUnchanged",
        "imageRootfsUnchanged"
      ],
      "additionalProperties": false
    },
    "retainedWorkRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "receiptPayloadSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "sourceCommit",
    "sourceTreeSha256",
    "buildReceipt",
    "buildReceiptSha256",
    "adapterImageTag",
    "adapterImageDigest",
    "adapterManifestDigest",
    "adapterOciArchiveSha256",
    "runtimeSessionId",
    "runtimeToolchainSha256",
    "runtimePolicySha256",
    "proofDependencyManifestSha256",
    "runtimeAttestationSha256Before",
    "runtimeAttestationSha256After",
    "driverCliSha256",
    "driverModuleSha256",
    "probePlanSha256",
    "probeAdapterSha256",
    "probePublicTestsSha256",
    "runControlReceipt",
    "runControlReceiptSha256",
    "rootlessReceipt",
    "rootlessReceiptSha256",
    "aggregateLimitEvidenceSha256",
    "invocationId",
    "finalContainerId",
    "commandSha256",
    "candidateWallSeconds",
    "elapsedMs",
    "resultReleased",
    "cleanup",
    "retainedWorkRoot",
    "verifiedAt",
    "receiptPayloadSha256"
  ],
  "additionalProperties": false
}
