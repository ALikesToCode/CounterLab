{
  "$id": "https://counterlab.dev/schemas/scientific-engine-runtime-v1.schema.json",
  "title": "CounterLab scientific engine runtime manifest v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "environmentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "environmentKind": {
      "type": "string",
      "enum": [
        "local_candidate",
        "cloudflare_production"
      ]
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "registryHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bindingsHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "platform": {
      "type": "object",
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "os",
        "architecture"
      ],
      "additionalProperties": false
    },
    "runtimes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "exactVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "licenseId": {
            "type": "string",
            "minLength": 1
          },
          "licenseFileHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "exactVersion",
          "sourceUrl",
          "licenseId",
          "licenseFileHash"
        ],
        "additionalProperties": false
      }
    },
    "installedEngines": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "engineId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "packageName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "exactVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "artifactSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "healthEvidenceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "toleranceProfileId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          }
        },
        "required": [
          "engineId",
          "packageName",
          "exactVersion",
          "artifactSha256",
          "healthEvidenceId",
          "toleranceProfileId"
        ],
        "additionalProperties": false
      }
    },
    "container": {
      "type": "object",
      "properties": {
        "imageDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "vcpu": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "memoryMb": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "diskMb": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "imageDigest",
        "vcpu",
        "memoryMb",
        "diskMb"
      ],
      "additionalProperties": false
    },
    "resourceLimitProfileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "lockHashes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "sbomHashes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "sbomManifestEvidenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "sbomManifestHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "vulnerabilityReportEvidenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "vulnerabilityReportHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "vexEvidenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "vexEvidenceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reachabilityEvidenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "reachabilityEvidenceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "vexApplicationEvidenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "vexApplicationEvidenceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "environmentId",
    "environmentKind",
    "sourceCommit",
    "registryHash",
    "bindingsHash",
    "platform",
    "runtimes",
    "installedEngines",
    "container",
    "resourceLimitProfileId",
    "lockHashes",
    "sbomHashes",
    "sbomManifestEvidenceId",
    "sbomManifestHash",
    "vulnerabilityReportEvidenceId",
    "vulnerabilityReportHash"
  ],
  "additionalProperties": false
}
